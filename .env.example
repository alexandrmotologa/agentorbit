# AgentOrbit Environment Configuration

# Server Port
PORT=8080

# Telegram Bot Token (from @BotFather)
# When set to mock_token or DEMO_MODE=true, the bot can operate in simulation mode
TELEGRAM_BOT_TOKEN=mock_bot_token_change_me

# Autonomous Demo Mode
# true: Runs deterministic multi-step synthetic simulations without requiring paid LLM keys
# false: Uses live LLM provider configured below
DEMO_MODE=true

# LLM Provider: 'mock' | 'openai' | 'anthropic' | 'gemini' | 'groq' | 'ollama'
LLM_PROVIDER=mock

# Live LLM API Keys (optional if DEMO_MODE=true)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Ollama local endpoint (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Database storage path
DATABASE_PATH=data/agentorbit.db
